\contentsline {section}{\numberline {10}Pitfalls}{25}{section.10}%
\contentsline {paragraph}{P1. Nothing validates flag combinations.}{25}{section*.33}%
\contentsline {paragraph}{P2. Conservation diagnostics do not catch the ill-posed pair.}{25}{section*.34}%
\contentsline {paragraph}{P3. A one-sided bad flag corrupts the whole solution, not just its wall.}{25}{section*.35}%
\contentsline {paragraph}{P4. \texttt {flux\_type::none} is silently \texttt {central}.}{26}{section*.36}%
\contentsline {paragraph}{P5. Coefficients are sampled at the endpoints, so a vanishing Jacobian makes flags inert.}{26}{section*.37}%
\contentsline {paragraph}{P6. A negative coefficient on an \emph {individual} diffusion term is an interior instability.}{26}{section*.38}%
\contentsline {paragraph}{P7. A deck file is only read when passed with \texttt {-if} / \texttt {-infile}.}{26}{section*.39}%
\contentsline {paragraph}{P8. \texttt {div(bothsides)} plus a penalty is over-determined.}{26}{section*.40}%
\contentsline {paragraph}{P9. Free flux at an inflow wall.}{26}{section*.41}%
\contentsline {paragraph}{P10. Measure wall slopes off the DG polynomial, not off a plot grid.}{27}{section*.42}%
\contentsline {paragraph}{P11 \textcolor {red!60!black}{\textsc {[unresolved]}}{}.}{27}{section*.43}%
